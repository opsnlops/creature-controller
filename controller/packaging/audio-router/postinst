#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # Create the service user before anything runs as it
    systemd-sysusers creature-audio-router.conf
fi
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    # Services stay disabled on first installation; device and routes are site-specific.
    if [ -n "${2:-}" ]; then
        # try-restart restarts only units that are running, the same action
        # debhelper's generated postinst uses.
        deb-systemd-invoke try-restart creature-audio-router.service 'creature-audio-router@*.service' || true
    fi
fi
exit 0
