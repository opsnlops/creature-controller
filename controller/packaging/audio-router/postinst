#!/bin/sh
set -e
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    # Services stay disabled on first installation; device and routes are site-specific.
    if [ -n "${2:-}" ]; then
        if systemctl is-active --quiet creature-audio-router.service; then
            deb-systemd-invoke restart creature-audio-router.service || true
        fi
        systemctl list-units --plain --no-legend --state=active 'creature-audio-router@*.service' |
            while read -r unit remainder; do
                deb-systemd-invoke restart "$unit" || true
            done
    fi
fi
exit 0
