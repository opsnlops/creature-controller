#!/bin/sh
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop creature-audio-router.service || true
    systemctl list-units --plain --no-legend --state=active 'creature-audio-router@*.service' |
        while read -r unit remainder; do
            deb-systemd-invoke stop "$unit" || true
        done
fi
exit 0
