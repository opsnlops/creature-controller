include("@CMAKE_CURRENT_BINARY_DIR@/CPackConfig.cmake")
set(CPACK_COMPONENTS_ALL creature-audio-router)
set(CPACK_PACKAGE_NAME creature-audio-router)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Multichannel audio router for Creature Workshop speakers")
set(CPACK_PACKAGE_VERSION "@CREATURE_AUDIO_ROUTER_VERSION@")
set(CPACK_DEBIAN_PACKAGE_VERSION "@CREATURE_AUDIO_ROUTER_VERSION@")
unset(CPACK_DEBIAN_PACKAGE_RELEASE)
